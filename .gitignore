# ── 依赖包 ──────────────────────────────────
# 体积大且可以靠 package.json 重新安装，不进版本库
node_modules/

# ── 密钥与环境配置（最重要，绝对不能提交）──────
# 数据库密码、API Token 一旦提交，即使后来删掉也留在 Git 历史里
# config.json 里有 OA 账号密码 —— 只提交 config.example.json
.env
.env.local
config.local.js
config.json

# ── 日志 ────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── 编辑器 / 操作系统生成的文件 ───────────────
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
# WPS / Office 打开文档时生成的锁文件，关掉就没了，别提交
~$*

# ── 构建产物 ────────────────────────────────
dist/
build/
